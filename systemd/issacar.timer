[Unit]
Description=Fire the Issacar weekly edition on Sunday mornings

[Timer]
OnCalendar=Sun *-*-* 08:00:00
# If the machine was off at that hour, run as soon as it comes up. Without
# this, one Sunday with the computer down loses the whole week's edition.
Persistent=true
# Spread the trigger over fifteen minutes: nothing here needs to be punctual,
# and it avoids competing with everything else that wakes at 8 sharp.
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target

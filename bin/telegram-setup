#!/usr/bin/env bash
#
# telegram-setup — finds the bot's chat id and writes it into the credentials
# file.
#
# This exists because it is the most fragile step of the setup: the documented
# route has you open a URL with the token embedded in your browser, read a JSON
# blob and locate a nested field. That is easy to get wrong, and it leaves the
# token in your browser history. Here the token never leaves the file.
#
#   bin/telegram-setup
#
# Prerequisite: you have already sent a message to your bot. Telegram forbids a
# bot from opening a conversation, so without that first message there is
# nothing to read.

set -euo pipefail

env="${IODE_NEWS_ENV:-$HOME/.config/iode/news.env}"

if [[ ! -f "$env" ]]; then
  echo "could not find $env" >&2
  exit 3
fi

# Extracts only the token line instead of sourcing the whole file. A file the
# user edits by hand should not be executed by the shell: a stray character
# becomes a command, and a placeholder containing "<" becomes a redirection.
IODE_TELEGRAM_TOKEN="$(sed -n 's/^IODE_TELEGRAM_TOKEN=//p' "$env" | head -1 | tr -d "\"'" )"

if [[ -z "$IODE_TELEGRAM_TOKEN" || "$IODE_TELEGRAM_TOKEN" == \<* ]]; then
  echo "IODE_TELEGRAM_TOKEN is not filled in yet at $env" >&2
  echo "open it with: code $env" >&2
  exit 3
fi

response="$(curl -sS --max-time 20 "https://api.telegram.org/bot${IODE_TELEGRAM_TOKEN}/getUpdates")"

# jq may not be installed; PHP is, and it is what this repository already uses.
# The output is only the chat id and the speaker's name — no credentials.
reading="$(php -r '
$d = json_decode(stream_get_contents(STDIN), true);
if (!is_array($d) || ($d["ok"] ?? false) !== true) {
    fwrite(STDERR, "Telegram refused the token: " . ($d["description"] ?? "resposta ilegivel") . "\n");
    exit(1);
}
$updates = $d["result"] ?? [];
if ($updates === []) {
    fwrite(STDERR, "no messages found.\n"
        . "open the chat with your bot, press START, send anything, then run this again.\n"
        . "(Telegram only keeps updates for 24h)\n");
    exit(2);
}
// The most recent one wins: if you messaged the bot from two places, the
// last one is the one you want.
$ultima = end($updates);
$chat = $ultima["message"]["chat"] ?? $ultima["channel_post"]["chat"] ?? null;
if ($chat === null) {
    fwrite(STDERR, "found updates, but none with an identifiable chat\n");
    exit(2);
}
printf("%s\t%s\t%s\n", $chat["id"], $chat["type"] ?? "?",
    trim(($chat["first_name"] ?? "") . " " . ($chat["last_name"] ?? "")) ?: ($chat["title"] ?? "sem nome"));
' <<<"$response")"

chat_id="$(cut -f1 <<<"$reading")"
type="$(cut -f2 <<<"$reading")"
who="$(cut -f3 <<<"$reading")"

echo "chat found: $who (type $type, id $chat_id)"

# Substitui a linha inteira, tenha ela placeholder ou um valor antigo.
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
chmod 600 "$tmp"
sed "s|^IODE_TELEGRAM_CHAT_ID=.*|IODE_TELEGRAM_CHAT_ID=$chat_id|" "$env" > "$tmp"
cat "$tmp" > "$env"   # sobrescreve o conteúdo e preserva dono e permissão

echo "written to $env"

# Confirms through the channel itself: if this message reaches your Telegram,
# the configuration is right end to end, not merely syntactically valid.
#
# The API response is read rather than discarded: without that the script
# announces success even when Telegram refused, and you go looking in vain for
# a message that never left.
sent="$(curl -sS --max-time 20 \
  -d "chat_id=$chat_id" \
  --data-urlencode 'text=Issacar configurado. A revista chega por aqui aos domingos.' \
  "https://api.telegram.org/bot${IODE_TELEGRAM_TOKEN}/sendMessage")"

php -r '
$d = json_decode(stream_get_contents(STDIN), true);
if (($d["ok"] ?? false) !== true) {
    fwrite(STDERR, sprintf("Telegram refused the send (%s): %s\n",
        $d["error_code"] ?? "?", $d["description"] ?? "sem descricao"));
    exit(1);
}
printf("test message delivered (id %d).\n", $d["result"]["message_id"]);
' <<<"$sent"

echo "look in the conversation with YOUR bot, not with BotFather:"
echo "  https://t.me/$(curl -sS --max-time 15 "https://api.telegram.org/bot${IODE_TELEGRAM_TOKEN}/getMe" \
  | php -r '$d=json_decode(stream_get_contents(STDIN),true); echo $d["result"]["username"] ?? "seu_bot";')"
